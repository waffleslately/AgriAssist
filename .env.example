PROJECT_NAME="India Agri-Advisory Platform"
ENVIRONMENT=development
API_V1_STR="/api/v1"
SECRET_KEY="dev-secret-key-change-in-production-1234567890"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agri_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine (Optional for Dev, Simulated if missing)
GEE_ENABLED=false
GEE_SERVICE_ACCOUNT=""
GEE_PRIVATE_KEY=""
GEE_PROJECT_ID=""

# Weather API (Open-Meteo free tier)
WEATHER_PROVIDER=open-meteo


# Firebase (Phone Auth)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=firebase-service-account.json
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=1:123456789:web:abcdef123456
FIREBASE_MESSAGING_SENDER_ID=123456789012

# Regional Language Default (hi=Hindi, mr=Marathi, te=Telugu, en=English)
DEFAULT_LANGUAGE=hi
